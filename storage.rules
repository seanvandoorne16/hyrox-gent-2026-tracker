// HYROX Gent 2026 Tracker — Firebase Storage Security Rules (voortgangsfoto's)
//
// Zelfde opzet als firestore.rules: brontekst in de repo, activeren via
// Firebase Console → Storage → Rules → plakken → Publiceren.
// Vervangt de open regel uit INSTRUCTIES.md ("allow read, write: if request.auth
// != null") door dezelfde e-mail-whitelist als de Firestore-rules, zodat een
// eventueel vreemd account (aangemaakt via de open "Account aanmaken"-knop) geen
// foto's van jullie kan zien of overschrijven.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email in [
        '[verwijderd-privé]',
        '[verwijderd-privé]',
        '[verwijderd-privé]'
      ];
    }
  }
}
